local function EnviarAlerta(nombreJugador, nombreArma)
    local datos = {
        username = "🔫 ALERTA DE ROBO",
        embeds = {{
            title = "⚠️ ¡ROBARON UN ARMA!",
            description = "**Jugador:** " .. nombreJugador .. "\n**Arma:** " .. nombreArma,
            color = 16711680,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    local ok, err = pcall(function()
        HttpService:PostAsync(WEBHOOK_URL, HttpService:JSONEncode(datos), Enum.HttpContentType.ApplicationJson)
